+/*
+===============
+VID_GetFrameRGB
+
+cs2-ai: read back the current frame for the RL bridge (RGB24, top-down)
+===============
+*/
+size_t VID_GetFrameRGB( byte *dest, size_t destsize, int *width, int *height )
+{
+	static byte *tmp;
+	static size_t tmpsize;
+	int w = gpGlobals->width, h = gpGlobals->height;
+	size_t rowbytes = (size_t)w * 3, need = rowbytes * h;
+
+	if( width ) *width = w;
+	if( height ) *height = h;
+	if( !dest || need > destsize || w <= 0 || h <= 0 )
+		return 0;
+
+	if( tmpsize < need )
+	{
+		tmp = realloc( tmp, need );
+		tmpsize = tmp ? need : 0;
+		if( !tmp ) return 0;
+	}
+
+	pglPixelStorei( GL_PACK_ALIGNMENT, 1 );
+	pglReadPixels( 0, 0, w, h, GL_RGB, GL_UNSIGNED_BYTE, tmp );
+
+	// GL is bottom-up
+	for( int y = 0; y < h; y++ )
+		memcpy( dest + rowbytes * y, tmp + rowbytes * ( h - 1 - y ), rowbytes );
+
+	return need;
+}
