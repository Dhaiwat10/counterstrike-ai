+qboolean Host_IsLockstep( void )
+{
+	if( host_framerate.value <= 0.0f || !host_lockstep.value )
+		return false;
+
+	// demos must be played back and recorded with the stock timing
+	if( !Host_IsDedicated( ) && ( CL_IsPlaybackDemo( ) || CL_IsRecordDemo( )))
+		return false;
+
+	return true;
+}
+
+/*
+===================
+Host_LockstepReport
+
+cs2-ai: periodically print how fast the lockstep loop runs
+===================
+*/
+static void Host_LockstepReport( void )
+{
+	static double walltime, gametime, svtime, cltime;
+	static int frames;
+	double now;
+
+	if( host_lockstep_report.value <= 0.0f || !Host_IsLockstep( ))
+	{
+		walltime = 0.0;
+		return;
+	}
+
+	// only count frames that actually simulate + draw the game
+	if( !CL_IsInGame( ) || !SV_Active( ))
+	{
+		walltime = 0.0;
+		return;
+	}
+
+	now = Platform_DoubleTime();
+
+	if( walltime == 0.0 )
+	{
+		walltime = now;
+		gametime = host.realtime;
+		svtime = SV_LockstepTime();
+		cltime = CL_LockstepTime();
+		frames = 0;
+		return;
+	}
+
+	frames++;
+
+	if( now - walltime >= host_lockstep_report.value )
+	{
+		double dt = now - walltime;
+		double fps = frames / dt;
+
+		Con_Printf( "lockstep: %d frames in %.2fs wall = %.1f fps, game %.2fs -> %.2fx realtime (tick %.4f; sv.time +%.2f cl.time +%.2f, cl-sv %+.3f)\n",
+			frames, dt, fps, host.realtime - gametime, ( host.realtime - gametime ) / dt, host_framerate.value,
+			SV_LockstepTime() - svtime, CL_LockstepTime() - cltime, Host_IsDedicated() ? 0.0 : CL_LockstepTime() - SV_LockstepTime( ));
+
+		walltime = now;
+		gametime = host.realtime;
+		svtime = SV_LockstepTime();
+		cltime = CL_LockstepTime();
+		frames = 0;
+	}
+}
