+// cs2-ai: read back the current frame for the RL bridge (RGB24, top-down)
+size_t GAME_EXPORT VID_GetFrameRGB( byte *dest, size_t destsize, int *width, int *height )
+{
+	int w = vid.width, h = vid.height;
+	size_t need = (size_t)w * h * 3;
+
+	if( width ) *width = w;
+	if( height ) *height = h;
+	if( !dest || need > destsize || w <= 0 || h <= 0 || swblit.rotate )
+		return 0;
+
+	for( int v = 0; v < h; v++ )
+	{
+		uint start = vid.rowbytes * v;
+		byte *d = dest + (size_t)w * 3 * v;
+
+		for( int u = 0; u < w; u++ )
+		{
+			uint32_t px = Get8888PixelAt( u, start ); // 0xAARRGGBB
+			*d++ = ( px >> 16 ) & 0xFF;
+			*d++ = ( px >> 8 ) & 0xFF;
+			*d++ = px & 0xFF;
+		}
+	}
+
+	return need;
+}
