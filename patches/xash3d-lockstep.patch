diff --git a/engine/common/bridge.h b/engine/common/bridge.h
new file mode 100644
index 0000000..5dc52ad
--- /dev/null
+++ b/engine/common/bridge.h
@@ -0,0 +1,93 @@
+/*
+bridge.h - cs2-ai RL bridge: lockstep action-in / frame-out channel to an external controller
+See /patches/BRIDGE.md in the cs2-ai repo for the protocol.
+
+Launch:  xash3d ... -bridge /path/to/socket -bridge_shm /path/to/frame.shm
+  The engine connects to a unix-domain stream socket (the controller listens),
+  maps the frame file, then every Host_Frame:
+    1. blocks reading one bridge_action_t
+    2. runs the frame, applying the action to the usercmd
+    3. writes the rendered frame (RGB24, top-down) into the shm file
+    4. sends one bridge_state_t
+*/
+#ifndef BRIDGE_H
+#define BRIDGE_H
+
+#include <stdint.h>
+
+#define BRIDGE_ACTION_MAGIC 0x31415343 // "CSA1"
+#define BRIDGE_STATE_MAGIC  0x31535343 // "CSS1"
+#define BRIDGE_MAX_PLAYERS  32
+#define BRIDGE_SHM_HEADER   64          // frame pixels start at this offset in the shm file
+#define BRIDGE_MAX_FRAME    ( 1920 * 1080 * 3 )
+
+// action flags
+#define BRIDGE_ACT_APPLY    ( 1 << 0 ) // override usercmd movement/buttons/angles with this action
+#define BRIDGE_ACT_CAPTURE  ( 1 << 1 ) // capture the rendered frame this step
+#define BRIDGE_ACT_QUIT     ( 1 << 2 ) // shut the engine down
+#define BRIDGE_ACT_SETANGLES ( 1 << 3 ) // demo playback: force the view to setangles (exact angles from a parsed demo)
+
+#pragma pack( push, 4 )
+typedef struct bridge_action_s
+{
+	uint32_t magic;
+	uint32_t seq;
+	uint32_t flags;
+	float    dyaw;          // degrees to add to view yaw this step (positive = turn left, like mouse left)
+	float    dpitch;        // degrees to add to view pitch (positive = look down)
+	float    forwardmove;   // units/s, like cl_forwardspeed (CS: +-400 clamped by maxspeed)
+	float    sidemove;      // positive = right
+	float    upmove;
+	uint32_t buttons;       // IN_* bitmask (in_buttons.h)
+	int32_t  impulse;
+	int32_t  weaponselect;
+	char     cmd[256];      // console command(s) to execute before this frame (empty = none)
+	float    setangles[3];  // with BRIDGE_ACT_SETANGLES: absolute pitch, yaw, roll
+} bridge_action_t;
+
+typedef struct bridge_player_s
+{
+	int32_t connected;
+	int32_t alive;
+	int32_t health;
+	int32_t armor;
+	int32_t frags;
+	int32_t team;           // 1 = T, 2 = CT, 0 = unknown/spectator (from the model/team when available)
+	float   origin[3];
+} bridge_player_t;
+
+typedef struct bridge_state_s
+{
+	uint32_t magic;
+	uint32_t seq;           // echoes the action seq this state answers
+	uint32_t in_game;       // client active and server running
+	uint32_t frame_valid;   // shm holds a frame rendered this step
+	uint32_t width;
+	uint32_t height;
+	uint32_t frame_bytes;
+	uint32_t framecount;
+	uint32_t demoplayback;  // a demo is playing
+	uint32_t pad0;
+	double   time;          // client time (cl.time; during demo playback = the original match clock)
+	int32_t  playernum;     // local player's slot (0-based), -1 if none
+	int32_t  num_players;
+	float    viewangles[3]; // local client's current view angles (pitch, yaw, roll)
+	float    velocity[3];
+	bridge_player_t players[BRIDGE_MAX_PLAYERS];
+} bridge_state_t;
+#pragma pack( pop )
+
+// engine-internal API
+#if !XASH_DEDICATED
+void CL_BridgeInit( void );
+qboolean CL_BridgeActive( void );
+void CL_BridgeBeginFrame( void );
+void CL_BridgeEndFrame( void );
+void CL_BridgeApplyAngles( float *viewangles );          // before CL_CreateMove
+void CL_BridgeApplyCmd( struct usercmd_s *cmd, const float *viewangles ); // after CL_CreateMove
+void CL_BridgeCapture( void );                           // in V_PostRender, before 2D overlays
+void CL_BridgeDemoAngles( float *viewangles );           // after demo angle interpolation
+#endif
+int SV_BridgeFillPlayers( bridge_player_t *out, int max ); // server side, returns maxclients
+
+#endif // BRIDGE_H
