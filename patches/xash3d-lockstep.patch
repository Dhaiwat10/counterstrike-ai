+/*
+================
+Sys_GameDoubleTime
+
+cs2-ai: absolute time handed to game/client dlls (pmove->Sys_FloatTime,
+GetAbsoluteTime). In lockstep mode the wall clock runs at a different rate
+than the game, so return game time to keep e.g. PM_CheckStuck rate limits
+deterministic.
+================
+*/
+double GAME_EXPORT Sys_GameDoubleTime( void )
+{
+	if( Host_IsLockstep( ))
+		return host.realtime;
+	return Platform_DoubleTime();
+}
