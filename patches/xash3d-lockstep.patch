diff --git a/engine/client/cl_bridge.c b/engine/client/cl_bridge.c
new file mode 100644
index 0000000..d28d5dc
--- /dev/null
+++ b/engine/client/cl_bridge.c
@@ -0,0 +1,236 @@
+/*
+cl_bridge.c - cs2-ai RL bridge (lockstep action-in / frame-out). See common/bridge.h.
+*/
+#include "common.h"
+#include "client.h"
+#include "bridge.h"
+
+#if XASH_POSIX
+#include <sys/socket.h>
+#include <sys/un.h>
+#include <sys/mman.h>
+#include <fcntl.h>
+#include <unistd.h>
+#include <errno.h>
+
+static struct
+{
+	int             sock;
+	int             shmfd;
+	byte           *shm;
+	size_t          shmsize;
+	qboolean        active;
+	bridge_action_t act;
+	qboolean        have_act;
+	qboolean        frame_valid;
+	int             width, height;
+	uint32_t        frame_bytes;
+} br = { -1, -1 };
+
+static qboolean Br_ReadFull( int fd, void *buf, size_t len )
+{
+	byte *p = buf;
+
+	while( len )
+	{
+		ssize_t n = read( fd, p, len );
+
+		if( n == 0 ) return false;
+		if( n < 0 )
+		{
+			if( errno == EINTR ) continue;
+			return false;
+		}
+		p += n;
+		len -= n;
+	}
+	return true;
+}
+
+static qboolean Br_WriteFull( int fd, const void *buf, size_t len )
+{
+	const byte *p = buf;
+
+	while( len )
+	{
+		ssize_t n = write( fd, p, len );
+
+		if( n < 0 )
+		{
+			if( errno == EINTR ) continue;
+			return false;
+		}
+		p += n;
+		len -= n;
+	}
+	return true;
+}
+
+void CL_BridgeInit( void )
+{
+	char sockpath[MAX_SYSPATH], shmpath[MAX_SYSPATH];
+	struct sockaddr_un addr;
+
+	if( !Sys_GetParmFromCmdLine( "-bridge", sockpath ))
+		return;
+
+	if( !Sys_GetParmFromCmdLine( "-bridge_shm", shmpath ))
+		Host_Error( "bridge: -bridge requires -bridge_shm <file>\n" );
+
+	br.sock = socket( AF_UNIX, SOCK_STREAM, 0 );
+	if( br.sock < 0 )
+		Host_Error( "bridge: socket() failed: %s\n", strerror( errno ));
+
+	memset( &addr, 0, sizeof( addr ));
+	addr.sun_family = AF_UNIX;
+	Q_strncpy( addr.sun_path, sockpath, sizeof( addr.sun_path ));
+
+	if( connect( br.sock, (struct sockaddr *)&addr, sizeof( addr )) < 0 )
+		Host_Error( "bridge: connect(%s) failed: %s\n", sockpath, strerror( errno ));
+
+	br.shmsize = BRIDGE_SHM_HEADER + BRIDGE_MAX_FRAME;
+	br.shmfd = open( shmpath, O_RDWR | O_CREAT, 0600 );
+	if( br.shmfd < 0 || ftruncate( br.shmfd, br.shmsize ) < 0 )
+		Host_Error( "bridge: can't open shm %s: %s\n", shmpath, strerror( errno ));
+
+	br.shm = mmap( NULL, br.shmsize, PROT_READ | PROT_WRITE, MAP_SHARED, br.shmfd, 0 );
+	if( br.shm == MAP_FAILED )
+		Host_Error( "bridge: mmap failed: %s\n", strerror( errno ));
+
+	br.active = true;
+	Con_Printf( "bridge: connected to %s, frames -> %s\n", sockpath, shmpath );
+}
+
+qboolean CL_BridgeActive( void )
+{
+	return br.active;
+}
+
+void CL_BridgeBeginFrame( void )
+{
+	if( !br.active )
+		return;
+
+	if( !Br_ReadFull( br.sock, &br.act, sizeof( br.act )) || br.act.magic != BRIDGE_ACTION_MAGIC )
+	{
+		br.active = false;
+		Con_Printf( "bridge: controller went away, quitting\n" );
+		Sys_Quit( "bridge closed" );
+		return;
+	}
+
+	br.have_act = true;
+	br.frame_valid = false;
+
+	if( br.act.flags & BRIDGE_ACT_QUIT )
+	{
+		br.active = false;
+		Sys_Quit( "bridge quit" );
+		return;
+	}
+
+	if( br.act.cmd[0] )
+	{
+		br.act.cmd[sizeof( br.act.cmd ) - 1] = 0;
+		Cbuf_AddText( br.act.cmd );
+		Cbuf_AddText( "\n" );
+	}
+}
+
+void CL_BridgeApplyAngles( float *viewangles )
+{
+	if( !br.active || !br.have_act || !( br.act.flags & BRIDGE_ACT_APPLY ))
+		return;
+
+	viewangles[PITCH] = bound( -89.0f, viewangles[PITCH] + br.act.dpitch, 89.0f );
+	viewangles[YAW] = anglemod( viewangles[YAW] + br.act.dyaw );
+	viewangles[ROLL] = 0.0f;
+
+	// consume the mouse delta: it must only apply once even if several cmds are built
+	br.act.dyaw = br.act.dpitch = 0.0f;
+}
+
+void CL_BridgeApplyCmd( usercmd_t *cmd, const float *viewangles )
+{
+	if( !br.active || !br.have_act || !( br.act.flags & BRIDGE_ACT_APPLY ))
+		return;
+
+	VectorCopy( viewangles, cmd->viewangles );
+	cmd->forwardmove = br.act.forwardmove;
+	cmd->sidemove = br.act.sidemove;
+	cmd->upmove = br.act.upmove;
+	cmd->buttons = (unsigned short)br.act.buttons;
+	cmd->impulse = (byte)br.act.impulse;
+	cmd->weaponselect = (byte)br.act.weaponselect;
+}
+
+void CL_BridgeDemoAngles( float *viewangles )
+{
+	if( !br.active || !br.have_act || !( br.act.flags & BRIDGE_ACT_SETANGLES ))
+		return;
+
+	VectorCopy( br.act.setangles, viewangles );
+}
+
+void CL_BridgeCapture( void )
+{
+	int w = 0, h = 0;
+	size_t n;
+
+	if( !br.active || !br.have_act || !( br.act.flags & BRIDGE_ACT_CAPTURE ))
+		return;
+
+	if( !ref.dllFuncs.VID_GetFrameRGB )
+		return;
+
+	n = ref.dllFuncs.VID_GetFrameRGB( br.shm + BRIDGE_SHM_HEADER, BRIDGE_MAX_FRAME, &w, &h );
+	br.width = w;
+	br.height = h;
+	br.frame_bytes = (uint32_t)n;
+	br.frame_valid = n > 0;
+}
+
+void CL_BridgeEndFrame( void )
+{
+	bridge_state_t st;
+
+	if( !br.active || !br.have_act )
+		return;
+
+	memset( &st, 0, sizeof( st ));
+	st.magic = BRIDGE_STATE_MAGIC;
+	st.seq = br.act.seq;
+	st.in_game = cls.state == ca_active && SV_Active( );
+	st.frame_valid = br.frame_valid;
+	st.width = br.width;
+	st.height = br.height;
+	st.frame_bytes = br.frame_bytes;
+	st.framecount = host.framecount;
+	st.demoplayback = cls.demoplayback;
+	st.time = cl.time;
+	st.playernum = cls.state == ca_active ? cl.playernum : -1;
+	VectorCopy( cl.viewangles, st.viewangles );
+	VectorCopy( cl.simvel, st.velocity );
+	st.num_players = SV_BridgeFillPlayers( st.players, BRIDGE_MAX_PLAYERS );
+
+	br.have_act = false;
+
+	if( !Br_WriteFull( br.sock, &st, sizeof( st )))
+	{
+		br.active = false;
+		Sys_Quit( "bridge closed" );
+	}
+}
+
+#else // !XASH_POSIX
+
+void CL_BridgeInit( void ) { }
+qboolean CL_BridgeActive( void ) { return false; }
+void CL_BridgeBeginFrame( void ) { }
+void CL_BridgeEndFrame( void ) { }
+void CL_BridgeApplyAngles( float *viewangles ) { }
+void CL_BridgeApplyCmd( usercmd_t *cmd, const float *viewangles ) { }
+void CL_BridgeCapture( void ) { }
+void CL_BridgeDemoAngles( float *viewangles ) { }
+
+#endif
