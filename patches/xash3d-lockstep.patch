 static qboolean Host_FilterTime( double time )
 {
 	static double	oldtime;
 	double scale = sys_timescale.value;
 
+	// cs2-ai: lockstep mode for RL. Every loop iteration advances the game
+	// by exactly one fixed tick of host_framerate seconds with no fps cap and
+	// no sleeping, for dedicated and listen servers alike. host.realtime
+	// becomes game time, so everything keyed off it (cl.time, sv.time, netchan,
+	// interpolation, prediction, cmd/update rates) stays consistent.
+	if( Host_IsLockstep( ))
+	{
+#if !XASH_DEDICATED
+		if( !Host_IsDedicated( ) && gl_vsync.value )
+		{
+			Con_Printf( "lockstep: disabling gl_vsync\n" );
+			Cvar_SetValue( "gl_vsync", 0.0f );
+		}
+#endif
+		host.frametime = host_framerate.value;
+		host.realframetime = host.frametime;
+		host.realtime += host.frametime;
+		oldtime = host.realtime;
+		return true;
+	}
+
 	host.realtime += time * scale;
 	double dt = host.realtime - oldtime;
 
