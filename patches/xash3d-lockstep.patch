+// cs2-ai: RL bridge, fill per-player stats (reward bookkeeping only, never fed to the agent)
+static int SV_BridgeTeamFromModel( const char *model )
+{
+	static const char *t_models[] = { "terror", "leet", "arctic", "guerilla", "militia" };
+	static const char *ct_models[] = { "urban", "gsg9", "sas", "gign", "vip", "spetsnaz" };
+	int i;
+
+	for( i = 0; i < ARRAYSIZE( t_models ); i++ )
+		if( !Q_stricmp( model, t_models[i] )) return 1;
+	for( i = 0; i < ARRAYSIZE( ct_models ); i++ )
+		if( !Q_stricmp( model, ct_models[i] )) return 2;
+	return 0;
+}
+
+int SV_BridgeFillPlayers( bridge_player_t *out, int max )
+{
+	int i, n;
+
+	memset( out, 0, sizeof( *out ) * max );
+
+	if( !SV_Active( ) || !svs.clients )
+		return 0;
+
+	n = Q_min( svs.maxclients, max );
+
+	for( i = 0; i < n; i++ )
+	{
+		sv_client_t *cl = &svs.clients[i];
+		edict_t *ed = cl->edict;
+
+		if( cl->state < cs_spawned || !ed || ed->free )
+			continue;
+
+		out[i].connected = 1;
+		out[i].alive = ed->v.deadflag == DEAD_NO && ed->v.health > 0.0f;
+		out[i].health = (int)ed->v.health;
+		out[i].armor = (int)ed->v.armorvalue;
+		out[i].frags = (int)ed->v.frags;
+		out[i].team = SV_BridgeTeamFromModel( Info_ValueForKey( cl->userinfo, "model" ));
+		VectorCopy( ed->v.origin, out[i].origin );
+	}
+
+	return n;
+}
