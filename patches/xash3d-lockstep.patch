 */
+qboolean Host_IsLockstep( void )
+{
+	if( host_framerate.value <= 0.0f || !host_lockstep.value )
+		return false;
+
+	// demos must be played back and recorded with the stock timing
+	if( !Host_IsDedicated( ) && CL_IsRecordDemo( ))
+		return false;
+	if( !Host_IsDedicated( ) && CL_IsPlaybackDemo( ) && !host_lockstep_demos.value )
+		return false;
+
+	return true;
